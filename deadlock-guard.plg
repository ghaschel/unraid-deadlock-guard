<?xml version="1.0" encoding="UTF-8"?>
<!-- Edit this template; scripts/build.py generates the release manifest. -->
<PLUGIN
  name="deadlock-guard"
  author="Guilherme Haschel"
  version="2026.09.28"
  launch="DeadlockGuard"
  pluginURL="https://raw.githubusercontent.com/ghaschel/unraid-deadlock-guard/main/deadlock-guard.plg"
  support="https://github.com/ghaschel/unraid-deadlock-guard/issues"
  icon="icon-deadlock-guard"
  min="7.3.0"
  max="7.3.999"
>
  <CHANGES><![CDATA[
### 2026.09.28
## What's Changed
* Add Deadlock Guard beta for Unraid VM and Docker handoffs by @ghaschel in https://github.com/ghaschel/unraid-deadlock-guard/pull/1
* Add beta releases and improve native handoffs by @ghaschel in https://github.com/ghaschel/unraid-deadlock-guard/pull/2

## New Contributors
* @ghaschel made their first contribution in https://github.com/ghaschel/unraid-deadlock-guard/pull/1

**Full Changelog**: https://github.com/ghaschel/unraid-deadlock-guard/commits/2026.09.28
  ]]></CHANGES>

  <!-- Check the host before downloading or installing anything. -->
  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
set -euo pipefail

version=$(sed -n 's/^version="\(.*\)"/\1/p' /etc/unraid-version)
case "$version" in
  7.3.[0-9]*) ;;
  *)
    echo 'Deadlock Guard requires Unraid 7.3.x' >&2
    exit 1
    ;;
esac

mkdir -p /boot/config/plugins/deadlock-guard/packages
    ]]></INLINE>
  </FILE>

  <!-- Versioned package and checksums are filled by the build script. -->
  <FILE Name="/boot/config/plugins/deadlock-guard/packages/deadlock-guard-2026.09.28-noarch-1.txz">
    <URL>https://github.com/ghaschel/unraid-deadlock-guard/releases/download/2026.09.28/deadlock-guard-2026.09.28-noarch-1.txz</URL>
    <SHA256>13d17ec4e7857be59cc9eaa7f06f028f0ec9cd34d6cfe663c92c3f536c906ddf</SHA256>
    <MD5>9c827c8847d31b33b3e81b48b0fffff5</MD5>
  </FILE>

  <!-- Install the exact verified package, retaining the existing configuration. -->
  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
set -euo pipefail

package='/boot/config/plugins/deadlock-guard/packages/deadlock-guard-2026.09.28-noarch-1.txz'
plugin_dir='/usr/local/emhttp/plugins/deadlock-guard'
expected_version='2026.09.28'

printf '%s  %s\n' '13d17ec4e7857be59cc9eaa7f06f028f0ec9cd34d6cfe663c92c3f536c906ddf' "$package" | sha256sum -c -

if [[ -x "$plugin_dir/scripts/lifecycle" ]]; then
  "$plugin_dir/scripts/lifecycle" check
  "$plugin_dir/scripts/lifecycle" upgrade "$$"
fi

# Install the version selected by this manifest, including same-version test rebuilds.
upgradepkg --install-new --reinstall "$package"

installed_version=$(cat "$plugin_dir/VERSION" 2>/dev/null || true)
if [[ "$installed_version" != "$expected_version" ]]; then
  printf 'Deadlock Guard installation failed: expected %s, found %s.\n' \
    "$expected_version" "${installed_version:-missing}" >&2
  exit 1
fi

# Package extraction prepares the module without restarting. Reload the API once
# after the verified payload and registration are in place.
"$plugin_dir/scripts/lifecycle" install --restart-api
echo 'Deadlock Guard installed.'
echo 'REBOOT REQUIRED after first installation: reboot Unraid when safe to activate VM protection.'
    ]]></INLINE>
  </FILE>

  <!-- Remove only plugin-owned files. Configuration and packages are retained. -->
  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
set -euo pipefail

/usr/local/emhttp/plugins/deadlock-guard/scripts/lifecycle remove
removepkg deadlock-guard

echo 'Deadlock Guard removed. Configuration and downloaded packages are retained on the flash drive.'
    ]]></INLINE>
  </FILE>
</PLUGIN>
